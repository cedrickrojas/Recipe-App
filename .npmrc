# @angular/fire and firebase-tools don't declare Angular 22 / npm 12 in their
# peerDependencies yet, even though they work fine with this project's stack.
# Without this, `npm ci` on CI (different npm version than local dev) can
# crash entirely while trying to strictly reconcile the peer dependency graph
# instead of just installing what package-lock.json already resolved.
legacy-peer-deps=true
